  "ZOOTOPIA_ANIMALS": [
    {
      "english": "European Rabbit",
      "korean": "굴토끼",
      "character_en": "Judy Hopps",
      "character": "주디 홉스",
      "role_en": "ZPD Police Officer",
      "role": "ZPD 경찰관",
      "desc": "세상을 더 좋게 만들겠다는 굳은 의지를 가진 주토피아 최초의 토끼 경찰로, 편견을 이겨내고 연쇄 실종 사건을 해결합니다.",
      "image": "/animals/zootopia/judy_hopps.png"
    },
    {
      "english": "Red Fox",
      "korean": "붉은여우",
      "character_en": "Nick Wilde",
      "character": "닉 와일드",
      "role_en": "Con-artist → ZPD Police Officer",
      "role": "사기꾼 → ZPD 경찰관",
      "desc": "냉소적인 성격의 뒷골목 사기꾼이었으나, 주디를 도와 사건을 해결한 뒤 주토피아 최초의 여우 경찰이자 파트너가 됩니다.",
      "image": "/animals/zootopia/nick_wilde.png"
    },
    {
